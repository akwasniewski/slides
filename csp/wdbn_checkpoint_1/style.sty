\newtcolorbox[auto counter, number within=section]{def_box}[1][]{
  breakable,
  enhanced,
  colback=white,
  colframe=white,
  boxrule=0pt,
  title=#1,
  colbacktitle=white,
  title style={
    left color=cfred,
    middle color=cfred!85!white,
    right color=cfred!70!white,
  },
  overlay={
    \draw[line width=0.5pt, cfred, rounded corners=1mm]
      ([xshift=1pt, yshift=-1pt]frame.north west)
        -- (frame.south west)
        -- ++(0.4\textwidth,0);
  }
}

