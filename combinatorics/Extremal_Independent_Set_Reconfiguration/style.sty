% Headings
\usepackage{tcolorbox}
\tcbuselibrary{skins, breakable}
\newtcolorbox{coloredblock}[2]{%
  enhanced,
  breakable,
  colback=white,
  colframe=#1,
  boxrule=0pt,
  frame hidden,
  borderline west={2pt}{0pt}{#1},
  left=8pt,
  right=4pt,
  top=4pt,
  bottom=4pt,
  before skip=1em,
  after skip=1em,
  fonttitle=\bfseries,
  coltitle=#1,
  title={#2}
}

\renewenvironment{theorem}[1]
  {\begin{coloredblock}{cfnavy}{#1}\itshape}
  {\end{coloredblock}}

\renewenvironment{proof}[1]
  {\begin{coloredblock}{cfpink}{#1}\itshape}
  {\end{coloredblock}}
  
\renewenvironment{lemma}[1]
  {\begin{coloredblock}{cfblue}{#1}\itshape}
  {\end{coloredblock}}

\renewenvironment{example}[1]
  {\begin{coloredblock}{cfyel}{#1}}
  {\end{coloredblock}}

\newenvironment{heading}[1] { \noindent \textcolor{cfred}{\textbf{#1}}\par } { \par }

\renewenvironment{fact}[1] { 
\textcolor{cfgr}{\textbf{#1}} } { \par}





