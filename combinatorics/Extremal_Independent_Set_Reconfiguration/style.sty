\newcommand{\mytitlefootline}{%
  \setbeamertemplate{footline}{%
    {\raggedleft\color{cfgr}\rule{0.4\paperwidth}{0.5pt}\par}
    \vspace{0.1cm}
    \color{footergrey}\rule{0.7\paperwidth}{0.4pt}\par
    \vspace{0.1cm}

    \nointerlineskip
    \hbox{%
      \hspace{0.5cm}%
      \parbox[b]{0.465\paperwidth}{%
        \raggedright
        {\color{footergrey}\scriptsize\textit{Universes for Generic Programs and Proofs}\\[0.1em]
        \scriptsize\textit{in Dependent Type Theory}}%
      }%
      \hfill
      \parbox[b]{0.4\paperwidth}{%
        \raggedleft
        {\color{footergrey}\scriptsize\insertauthor\\[0.5em]}%
      }%
      \hspace{0.3cm}%
      \raisebox{-0.5em}{\includegraphics[height=0.85cm]{images/tcs.png}}%
      \hspace{0.5cm}%
    }%
    \vspace{0.25cm}%
  }%
}

\setbeamertemplate{footline}{}

\setbeamertemplate{frametitle}[default][left, leftskip=.25cm] {}
\addtobeamertemplate{title page}{}{%
  \vspace{1em}
  \begin{center}
    \includegraphics[height=1cm]{images/uj-logo.png}
  \end{center}
}

\newcounter{frameref} % counter for frame references

% command to place a reference mark in the text
\newcommand{\framemark}{%
  \stepcounter{frameref}%
  {\scriptsize\textsuperscript{\color{cfgrey}\theframeref}}%
}

% command to display the reference at the end of the frame
\newcommand{\framereference}[2][]{%
  \ifx\\#1\\%
    \edef\marknum{\theframeref}%
  \else
    \edef\marknum{#1}%
  \fi
  \vspace{0.5em}
  \begin{flushright}
    {\scriptsize\color{cfgrey}\textsuperscript{\marknum}\parbox{0.6\textwidth}{#2}}%
  \end{flushright}
  \vspace{0.5em}
}


