% Shift-chain diagrams: columns are vertices, rows are edges (as in the paper).
% Usage (Figure 1a):
%   \begin{shiftchain}{6}
%     \shiftedge{1,2,3,4/gray}
%     \shiftedge{1,2,3,5/gray}
%     \shiftedge{1,3,4,5/gray}
%     \shiftedge{2,3,4,6/gray}
%     \shiftedge{3,4,5,6/gray}
%   \end{shiftchain}
% \shiftvertexcolor{1,3}{cfred} colours those columns in subsequent rows.
% \shiftedge[cfblue]{1,2,4,6/cfred} sets a row's default colour; vertex
% colours override it, and an explicit vertex/colour overrides both.
% An optional label AFTER the vertex list labels the row on the left:
% \shiftedge{1,2,3,4}[$e_1$] or \shiftedge[cfblue]{2,3,4,5}[$e_2$].
% Options: column sep, row sep, dot radius, dot color, labels=true/false,
% label font, and tikz options (e.g. tikz options={scale=1.2}).
% bars={2,4} draws vertical bars after columns 2 and 4, spanning the dot rows.
% bar style={dashed} makes them dashed; any TikZ drawing options are allowed,
% e.g. \begin{shiftchain}[bars={2,4},bar style={dashed,cfred}]{6}.
% A /style suffix overrides an individual bar: bars={2,4/dashed,6}.
% Use /solid to override a globally dashed bar style.
% bar labels={2/$x_1$,4/$y_2$} puts labels below the corresponding bars.
% Labels use label font; labels=false hides only the vertex column numbers.
\pgfkeys{
  /shiftchain/.is family,
  /shiftchain,
  column sep/.store in=\shiftchain@columnsep,
  row sep/.store in=\shiftchain@rowsep,
  dot radius/.store in=\shiftchain@radius,
  dot color/.store in=\shiftchain@color,
  labels/.is choice,
  labels/true/.code={\def\shiftchain@labels{1}},
  labels/false/.code={\def\shiftchain@labels{0}},
  label font/.store in=\shiftchain@labelfont,
  bars/.store in=\shiftchain@bars,
  bar style/.store in=\shiftchain@barstyle,
  bar labels/.store in=\shiftchain@barlabels,
  tikz options/.store in=\shiftchain@tikzoptions
}
\newcount\shiftchain@row
\newenvironment{shiftchain}[2][]{%
  \pgfkeys{/shiftchain/.cd,
    column sep=5mm, row sep=5mm, dot radius=1.2pt,
    dot color=black, labels=true, label font=\small,
    bars={}, bar style={}, bar labels={},
    tikz options={},#1}%
  \shiftchain@row=0\relax
  \begin{tikzpicture}[x=\shiftchain@columnsep,y=\shiftchain@rowsep,
    baseline=(current bounding box.center),
    every node/.style={font=\shiftchain@labelfont},
    style/.expand once=\shiftchain@tikzoptions]
    \ifnum\shiftchain@labels=1\relax
      \foreach \shiftchain@vertex in {1,...,#2} {%
        \node[inner sep=0pt] at (\shiftchain@vertex,0)
          {$\shiftchain@vertex$};%
      }%
    \fi
}{%
  \ifnum\shiftchain@row>0\relax
    \ifx\shiftchain@bars\@empty\else
      \foreach \shiftchain@entry in \shiftchain@bars {%
        \expandafter\shiftchain@drawbar\shiftchain@entry//\@nil
      }%
    \fi
    \ifx\shiftchain@barlabels\@empty\else
      \foreach \shiftchain@entry in \shiftchain@barlabels {%
        \expandafter\shiftchain@drawbarlabel\shiftchain@entry//\@nil
      }%
    \fi
  \fi
  \end{tikzpicture}%
}
\def\shiftchain@drawbar#1/#2/#3\@nil{%
  \draw[black,solid,line width=0.4pt,
    style/.expand once=\shiftchain@barstyle,#2]
    ({#1+0.5},-0.5)
    -- ({#1+0.5},{-\the\shiftchain@row-0.5});%
}
\def\shiftchain@drawbarlabel#1/#2/#3\@nil{%
  \node[anchor=north,inner xsep=0pt,inner ysep=2pt]
    at ({#1+0.5},{-\the\shiftchain@row-0.5}) {#2};%
}
\newcommand{\shiftvertexcolor}[2]{%
  \@for\shiftchain@vertex:=#1\do{%
    \expandafter\def\csname shiftchain@vertexcolor@\shiftchain@vertex\endcsname{#2}%
  }%
}
\NewDocumentCommand{\shiftedge}{O{\shiftchain@color} m o}{%
  \advance\shiftchain@row by 1\relax
  \def\shiftchain@rowcolor{#1}%
  \foreach \shiftchain@entry in {#2} {%
    \expandafter\shiftchain@dot\shiftchain@entry//\@nil
  }%
  \IfValueT{#3}{%
    \node[anchor=east,inner xsep=2pt,inner ysep=0pt]
      at (0.5,-\the\shiftchain@row) {#3};%
  }%
}
\def\shiftchain@dot#1/#2/#3\@nil{%
  \def\shiftchain@dotcolor{#2}%
  \ifx\shiftchain@dotcolor\@empty
    \ifcsname shiftchain@vertexcolor@#1\endcsname
      \expandafter\let\expandafter\shiftchain@dotcolor
        \csname shiftchain@vertexcolor@#1\endcsname
    \else
      \let\shiftchain@dotcolor\shiftchain@rowcolor
    \fi
  \fi
  \fill[\shiftchain@dotcolor] (#1,-\the\shiftchain@row)
    circle[radius=\shiftchain@radius];%
}

