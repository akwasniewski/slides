\newcommand{\switchparity}{\textbf{Parity.} A monochromatic edge has an even number of switches in each gap.\par}
\newcommand{\Xone}{\textbf{X1.} Every edge $\vec f$ has exactly one or two switches in $c_X$.\par}
\newcommand{\Xtwo}{\textbf{X2.} If $\vec f$ contains $x_j,x_{j+1}$, then $x_{j+1}=f_4^-$.\par}
\newcommand{\Xthree}{\textbf{X3.} Every monochromatic edge in $c_X$ is a $(3,4)$-edge.\par}
\newcommand{\Yone}{\textbf{Y1.} every edge has one or two switches in $c_{Y,t}$.\par}
\newcommand{\Ytwo}{\textbf{Y2.} $x_{j-1}<y_j(t)\leq x_j$.\par}
\newcommand{\Ythree}{\textbf{Y3.} For $\vec e\in E(H)$, $e_1<x_j\Rightarrow e_2<y_{j+1}(t)$.\par}
\newcommand{\Yfour}{\textbf{Y4.} There are no $(1,2)$-edges in $c_{Y,t}$.\par}
\newcommand{\Yfive}{\textbf{Y5.} If $\vec e$ is a $(2,3)$-edge with switches $y_{j-1}(t),y_j(t)$, then $e_3^-=y_j(t)<x_j$, and some $\vec g\in E(H)$ has $y_j(t)=g_3^-$ and $y_{j+1}(t)<g_4$.\par}
\newcommand{\Ysix}{\textbf{Y6.} Every monochromatic edge in $c_Y$ is a $(2,3)$-edge.\par}
\newcommand{\Zone}{\textbf{Z1.} $c_{Z,t}$ is 3-well-spread: every edge has at most three switches.\par}
\newcommand{\Ztwo}{\textbf{Z2.} $M(c_{Z,t})\subsetneq M(c_{Z,t-1})$ for $t\geq1$.\par}
\newcommand{\Zthree}{\textbf{Z3.} Every monochromatic edge in $c_{Z,t}$ is a $(2,3)$-edge, with $z<\vec f$ for all $z\in Z(t)$.\par}
\newcommand{\Zfour}{\textbf{Z4.} For each $z\in Z(t)$, some $j\in[s]$ and $v\in[n]$ satisfy $y_j=v^-$ and $z=v^+\leq x_j$.\par}

